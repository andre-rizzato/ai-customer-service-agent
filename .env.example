# Copie para .env e preencha. Nunca commite o .env de verdade.

PORT=3000
AGENT_CONFIG_PATH=./config/agent.config.json

# --- LLM (escolha um) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Embeddings (RAG) ---
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=
# EMBEDDING_PROVIDER=local   # sem custo, sem API key, roda modelo local

# --- Canal: Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Canal: WhatsApp (Meta Cloud API) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Handoff ---
# Se agent.config.json tiver "handoffNotifier": "webhook", defina a URL abaixo
# (ex.: um Incoming Webhook do Slack).
HANDOFF_WEBHOOK_URL=

# --- Armazenamento local ---
CONVERSATIONS_DIR=./data/conversations
AUDIT_LOG_PATH=./data/audit-log.jsonl
