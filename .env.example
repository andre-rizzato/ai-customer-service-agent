# Copie para .env e preencha. Nunca commite o .env de verdade.

PORT=3000
AGENT_CONFIG_PATH=./config/agent.config.json

# --- LLM (escolha um) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Embeddings (RAG) ---
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=
# EMBEDDING_PROVIDER=local   # sem custo, sem API key, roda modelo local

# --- Canal: Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Bot do ATENDENTE separado (opcional, ver docs/HANDOFF_RELAY.md seção 4.1):
# com ele, TELEGRAM_BOT_TOKEN fica só pra clientes e este recebe os alertas de
# handoff e as respostas do atendente (webhook /webhook/telegram-desk). Sem
# ele, um bot só faz as duas coisas. O segredo cai no TELEGRAM_WEBHOOK_SECRET
# se ficar vazio.
HANDOFF_TELEGRAM_BOT_TOKEN=
HANDOFF_TELEGRAM_WEBHOOK_SECRET=

# --- Canal: WhatsApp (Meta Cloud API) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# "App Secret" do app no Meta for Developers (não confundir com o
# ACCESS_TOKEN acima) — usado pra validar a assinatura HMAC-SHA256 de cada
# webhook recebido (ver docs/SECURITY_REVIEW.md item #3). Obrigatório
# sempre que WHATSAPP_ACCESS_TOKEN estiver definido — config.ts falha
# rápido na inicialização se faltar.
WHATSAPP_APP_SECRET=

# --- Widget embarcável (canal "web" fora deste domínio) ---
# Lista de origens separadas por vírgula autorizadas a chamar /webhook/web
# de um browser em outro domínio (ex.: o site do cliente que incorporou o
# widget). Vazio = só same-origin funciona (comportamento de teste local via
# whatsapp.html). Ver docs/artifacts/widget-embarcavel.html.
WIDGET_ALLOWED_ORIGINS=

# --- Handoff ---
# Se agent.config.json tiver "handoffNotifier": "webhook", defina a URL abaixo
# (ex.: um Incoming Webhook do Slack).
HANDOFF_WEBHOOK_URL=

# Relay de handoff pelo Telegram ("handoffNotifier": "telegram"): chat ids
# dos atendentes, separados por vírgula. Eles recebem o alerta no chat com o
# bot (TELEGRAM_BOT_TOKEN) e respondem ao cliente dando "Responder" (reply)
# no alerta. Pra descobrir o seu chat id, mande /meuid pro bot. Exige
# TELEGRAM_WEBHOOK_SECRET definido (config.ts recusa o boot sem ele).
HANDOFF_TELEGRAM_CHAT_IDS=
# URL pública HTTPS deste servidor, sem barra no final (ex.:
# https://rizzato-tech.rizzatotech.com). Só usada pro botão "Abrir conversa"
# (Mini App) no alerta — sem ela, o alerta sai só com reply + "Devolver ao bot".
PUBLIC_BASE_URL=

# --- Qdrant (busca do catálogo — ver src/knowledge/qdrantStore.ts) ---
# Sem valor, usa http://localhost:6333 (Qdrant local, docker-compose do
# AgentService irmão). Em produção, aponta pro mesmo Qdrant hospedado no
# Azure Container Apps já usado pelo AgentService (mesmos nomes de secret no
# Key Vault: qdrant-url / qdrant-api-key — ver KEY_VAULT_ENABLED abaixo).
QDRANT_URL=
QDRANT_API_KEY=

# --- Armazenamento local ---
CONVERSATIONS_DIR=./data/conversations
AUDIT_LOG_PATH=./data/audit-log.jsonl

# --- AgentService (capacidade "order" — ver Mapa de Capacidades) ---
# Obrigatório só se agent.config.json tiver "order" em enabledCapabilities.
# URL do serviço Python standalone (DistributedOrderSystem/src/AgentService,
# `uvicorn main:app --port 8100`) que de fato consulta o backend de pedidos.
AGENT_SERVICE_URL=

# --- Azure Key Vault (opcional) ---
# Se true, os segredos acima (chaves de API, tokens do Telegram/WhatsApp,
# HANDOFF_WEBHOOK_URL) são buscados no Key Vault em vez de lidos daqui —
# os campos continuam existindo neste arquivo só como fallback/documentação.
# Autenticação via Managed Identity (na VM) ou `az login` (localmente), sem
# configuração extra. Nomes dos secrets no vault: kebab-case da variável
# (ex.: ANTHROPIC_API_KEY -> anthropic-api-key).
KEY_VAULT_ENABLED=false
KEY_VAULT_NAME=
